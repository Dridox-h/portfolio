FROM node:18-alpine

LABEL maintainer="portfolio"
LABEL description="Portfolio React application - development"

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci --silent

# Copy source code
COPY . .

# Environment variables for Vite
ENV HOST=0.0.0.0
ENV PORT=5173

EXPOSE 5173

CMD ["npm", "run", "dev"]
